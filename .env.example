POSTGRES_USER=jinhunt
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=jinhunt

# Fill with real operator details before a public launch. Blank values show a draft banner.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_HOSTING_LOCATION=
LEGAL_SERVICE_PROVIDERS=
PUBLIC_BASE_URL=http://localhost:8000

# Guardian confirmation requires a real SMTP service; no links/tokens are returned to the player.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Human review is on by default. Optional local image model:
MODERATION_REQUIRE_REVIEW=1
AUTO_APPROVE_SCANNED=1
INSTALL_IMAGE_SCANNER=1
IMAGE_SCANNER=nudenet

# Set a persistent Fernet key before enrolling staff 2FA. Never commit the real key.
STAFF_TOTP_KEY=
STAFF_COOKIE_SECURE=1
